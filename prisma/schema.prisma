generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
}

model Job {
  id          String        @id @default(cuid())
  title       String
  company     String
  location    String
  type        String        @default("Full-time")
  salary      String
  description String
  skills      String
  createdAt   DateTime      @default(now())
  applications Application[]
}

model Application {
  id          String            @id @default(cuid())
  candidate   String
  email       String
  phone       String?
  resumeUrl   String?
  coverLetter String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
